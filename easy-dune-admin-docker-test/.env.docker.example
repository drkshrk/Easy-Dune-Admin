# Copy to `.env` next to docker-compose.test.yml before testing.

# Browser port on the Docker host.
EDA_PORT=8088

# Host path to RedBlink's dune-awakening-selfhost-docker install.
REDBLINK_HOST_DIR=/home/steihl/dune-awakening-selfhost-docker

# Container path for the mounted RedBlink stack.
DUNE_ROOT_CONTAINER=/redblink

# Generate your own:
#   openssl rand -hex 32
DUNE_SECRET_KEY=change-this-secret-before-sharing

# Command-backed panels usually need Docker socket access. Leave shell disabled
# unless the container is on a trusted LAN/VPN and only trusted admins can log in.
ENABLE_HOST_COMMAND_RUNNER=1
ENABLE_STACK_INSTALLER=0
ENABLE_HOST_SHELL=0

DEFAULT_WATER_REFILL_AMOUNT=1000000
MARKET_PRICE_MULTIPLIER=5

# RedBlink default. Change only if your Postgres container has a different name.
POSTGRES_CONTAINER=dune-postgres
