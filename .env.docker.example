# Copy to `.env` next to docker-compose.yml before running.

# Browser port on the Docker host.
EDA_PORT=8089

# Host path to RedBlink's dune-awakening-selfhost-docker install.
REDBLINK_HOST_DIR=/home/steihl/dune-awakening-selfhost-docker

# Absolute host path to this Easy Dune Admin checkout. Docker-mode self-update
# uses this to start a detached updater container that can pull GitHub source,
# rebuild the image, and replace the running webadmin container.
EASY_DUNE_HOST_DIR=/home/steihl/easy-dune-admin
EASY_DUNE_SOURCE_DIR_CONTAINER=/host-easy-dune-admin
EASY_DUNE_UPDATER_IMAGE=docker:27.5.1-cli

# Container path for the mounted RedBlink stack.
DUNE_ROOT_CONTAINER=/redblink

# Default login profile for the Docker package. Users can still choose a
# different profile at login. Hyper-V mode requires the SSH values below.
EASY_DUNE_DEFAULT_INSTALL_MODE=docker
EASY_DUNE_HYPERV_SSH_TARGET=
EASY_DUNE_HYPERV_DUNE_ROOT=/home/steam/dune-awakening-selfhost-docker

# Generate your own:
#   openssl rand -hex 32
DUNE_SECRET_KEY=change-this-secret-before-sharing

# Command-backed panels usually need Docker socket access. Leave shell disabled
# unless the container is on a trusted LAN/VPN and only trusted admins can log in.
ENABLE_HOST_COMMAND_RUNNER=1
ENABLE_STACK_INSTALLER=0
ENABLE_HOST_SHELL=0
ENABLE_SELF_UPDATE=1

DEFAULT_WATER_REFILL_AMOUNT=1000000
MARKET_PRICE_MULTIPLIER=5

# RedBlink default. Change only if your Postgres container has a different name.
POSTGRES_CONTAINER=dune-postgres
